PORT=3000
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Minimum cosine score (0-1) a chunk must beat to be returned by /search.
# Leave blank for no floor. Tune by running real queries and watching the
# scores - a value that works for one embedding model won't transfer to another.
SEARCH_SCORE_THRESHOLD=

# How many chunks /search returns by default. A per-request "top_k" in the
# body overrides this; the response can still be shorter if the threshold
# above filters some out.
SEARCH_TOP_K=3

POSTGRES_HOST=localhost
POSTGRES_PORT=5431
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

GEMINI_API_KEY=
